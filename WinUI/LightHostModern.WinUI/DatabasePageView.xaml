<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="LightHostModernWinUI.DatabasePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" AutomationProperties.AutomationId="PluginScanProgressContent">
        <TextBlock x:Name="PluginScanStatusText" AutomationProperties.AutomationId="PluginScanStatus" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
        <ProgressBar x:Name="PluginScanProgress" AutomationProperties.AutomationId="PluginScanProgress" Maximum="1" Value="0" Visibility="Collapsed" />
        <TextBlock x:Name="PluginScanCurrentFileText" AutomationProperties.AutomationId="PluginScanCurrentFile" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryCaptionStyle}" Visibility="Collapsed" />
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="PluginScanCompletedValue" AutomationProperties.AutomationId="PluginScanCompleted" Text="0/0" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PluginScanCompletedLabel" Text="Processed" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="PluginScanCachedValue" AutomationProperties.AutomationId="PluginScanCached" Text="0" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PluginScanCachedLabel" Text="Cached" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock x:Name="PluginScanFailureValue" AutomationProperties.AutomationId="PluginScanFailureCount" Text="0" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PluginScanFailureLabel" Text="Failures" Style="{StaticResource SecondaryCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PluginScanFailuresText" TextWrapping="Wrap" Style="{StaticResource SecondaryCaptionStyle}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
